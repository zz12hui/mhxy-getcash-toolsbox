.tab-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #0f1623;
  border-top: 1rpx solid rgba(255,255,255,0.06);
}

.tab-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  gap: 2rpx;
}

.tab-bar-icon {
  font-size: 36rpx;
}

.tab-bar-label {
  font-size: 20rpx;
  color: #6b7d95;
}

.tab-bar-item.active .tab-bar-label {
  color: #00d4aa;
}
