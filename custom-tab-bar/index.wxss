.tab-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 108rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: linear-gradient(180deg, rgba(13, 23, 40, 0.96), rgba(8, 14, 24, 0.99));
  border-top: 1rpx solid rgba(120, 180, 220, 0.12);
  box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.35);
}

.tab-hidden {
  display: none;
}

.tab-bar-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  gap: 2rpx;
  transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
}

.tab-bar-item:active {
  transform: scale(0.94);
}

.tab-active-bg {
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 132rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(56, 242, 200, 0.18), rgba(58, 167, 255, 0.08));
  border: 1rpx solid rgba(56, 242, 200, 0.35);
  box-shadow: 0 0 24rpx rgba(56, 242, 200, 0.12);
}

.tab-bar-icon {
  position: relative;
  z-index: 1;
  font-size: 34rpx;
  transition: transform 180ms ease-out;
}

.tab-bar-item.active .tab-bar-icon {
  transform: translateY(-2rpx) scale(1.06);
}

.tab-bar-label {
  position: relative;
  z-index: 1;
  font-size: 19rpx;
  color: #6b7d95;
  transition: color 180ms ease-out;
}

.tab-bar-item.active .tab-bar-label {
  color: #38f2c8;
}

/* 大屏 / 高分辨率：固定 px 尺寸，避免 rpx 随窗口放大后比例失衡 */
@media (min-width: 768px) {
  .tab-bar {
    height: 64px;
    padding-bottom: 0;
    max-width: 900px;
    margin: 0 auto;
    border-radius: 18px 18px 0 0;
    border: 1px solid rgba(120, 180, 220, 0.12);
    border-bottom: 0;
  }

  .tab-active-bg {
    width: 92px;
    height: 48px;
    top: 6px;
    border-radius: 14px;
  }

  .tab-bar-icon {
    font-size: 22px;
  }

  .tab-bar-label {
    font-size: 12px;
  }
}

