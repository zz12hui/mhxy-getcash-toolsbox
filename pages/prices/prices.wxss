.prices-page {
  background: #060a12;
}

.prices-content {
  padding: 20rpx 24rpx 40rpx;
}

.prices-nav {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 18rpx;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: var(--text2);
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

.ratio-card {
  padding: 24rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, rgba(255, 200, 87, 0.10), rgba(18, 30, 50, 0.92));
  border: 1rpx solid rgba(255, 200, 87, 0.28);
  margin-bottom: 18rpx;
}

.ratio-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ratio-title {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--text);
}

.ratio-role {
  font-size: 19rpx;
  color: var(--text2);
}

.ratio-line {
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--warn);
}

.ratio-sub {
  margin-top: 8rpx;
  font-size: 18rpx;
  color: var(--text2);
}

.seg {
  display: flex;
  gap: 8rpx;
  padding: 6rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  margin-bottom: 18rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: var(--text2);
  transition: all 160ms ease-out;
}

.seg-item.on {
  color: var(--accent);
  background: rgba(56, 242, 200, 0.12);
  border: 1rpx solid rgba(56, 242, 200, 0.3);
}

.price-block {
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(18, 30, 50, 0.86);
  border: 1rpx solid rgba(120, 180, 220, 0.10);
  margin-bottom: 16rpx;
}

.price-block-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.price-block-title {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--text);
}

.price-link {
  font-size: 20rpx;
  color: var(--accent);
}

.price-unit {
  font-size: 18rpx;
  color: var(--text2);
}

.price-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 11rpx 0;
  border-bottom: 1rpx solid rgba(120, 180, 220, 0.08);
  font-size: 22rpx;
}

.price-row:last-child {
  border-bottom: 0;
}

.price-head {
  font-size: 18rpx;
  color: var(--text2);
  padding: 4rpx 0 8rpx;
}

.price-name {
  flex: 1;
  min-width: 0;
  color: var(--text);
}

.price-val {
  width: 150rpx;
  text-align: right;
  color: var(--text2);
}

.price-val.is-custom {
  color: var(--accent);
  font-weight: 600;
}

.prices-note {
  font-size: 19rpx;
  color: var(--text2);
  line-height: 1.7;
  padding: 6rpx 6rpx 0;
}

@media (min-width: 768px) {
  .prices-content {
    max-width: 780px;
    margin: 0 auto;
  }
}
