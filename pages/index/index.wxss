page {
  height: 100%;
  overflow: hidden;
  padding-bottom: 0;
}

.home-page {
  position: relative;
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: 132rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #060a12 0%, #0a1322 58%, #0b1524 100%);
}

.hub-bg {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(180rpx);
  opacity: 0.5;
}

.orb1 {
  width: 520rpx;
  height: 520rpx;
  background: radial-gradient(circle, rgba(56, 242, 200, 0.16), transparent 68%);
  top: -200rpx;
  right: -150rpx;
}

.orb2 {
  width: 460rpx;
  height: 460rpx;
  background: radial-gradient(circle, rgba(58, 167, 255, 0.13), transparent 68%);
  bottom: 40rpx;
  left: -180rpx;
}

.orb3 {
  width: 380rpx;
  height: 380rpx;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.10), transparent 70%);
  top: 42%;
  left: 48%;
}

.grid-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-image:
    linear-gradient(rgba(120, 180, 220, 0.03) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(120, 180, 220, 0.03) 1rpx, transparent 1rpx);
  background-size: 56rpx 56rpx;
}

.home-inner {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 14rpx 26rpx 0;
  box-sizing: border-box;
  overflow: hidden;
}

.hub-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.hub-brand {
  font-size: 21rpx;
  color: var(--text2);
  letter-spacing: 1rpx;
}

.hub-slogan {
  margin-top: 2rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text);
  line-height: 1.2;
}

.accent-text {
  color: var(--accent);
  text-shadow: 0 0 24rpx rgba(56, 242, 200, 0.35);
}

.hub-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 700;
  color: var(--accent);
  background: linear-gradient(135deg, rgba(56, 242, 200, 0.18), rgba(58, 167, 255, 0.10));
  border: 1rpx solid rgba(56, 242, 200, 0.45);
  box-shadow: 0 0 26rpx rgba(56, 242, 200, 0.18);
}

/* 收益账本大栏目 */
.ledger-hero {
  margin: 0;
  padding: 20rpx 24rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, rgba(56, 242, 200, 0.13), rgba(13, 24, 40, 0.95) 55%, rgba(58, 167, 255, 0.10));
  border: 1rpx solid rgba(56, 242, 200, 0.32);
  box-shadow: 0 14rpx 40rpx rgba(0, 0, 0, 0.36), inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
  flex-shrink: 0;
}

.ledger-hero:active {
  transform: scale(0.985);
  transition: transform 150ms ease-out;
}

.lh-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.lh-title-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.lh-icon { font-size: 26rpx; }

.lh-title {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--text);
}

.lh-badge {
  font-size: 17rpx;
  color: var(--accent);
  border: 1rpx solid rgba(56, 242, 200, 0.35);
  border-radius: 999rpx;
  padding: 2rpx 10rpx;
  background: rgba(56, 242, 200, 0.06);
}

.lh-arrow {
  font-size: 21rpx;
  color: var(--text2);
}

.lh-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 14rpx;
  margin-top: 10rpx;
}

.lh-label {
  display: block;
  font-size: 20rpx;
  color: var(--text2);
}

.lh-value {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.15;
  margin-top: 2rpx;
  word-break: break-all;
  text-shadow: 0 0 32rpx rgba(56, 242, 200, 0.22);
}

.lh-value-sm {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
  margin-top: 2rpx;
}

.lh-spark {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 38rpx;
  margin-top: 10rpx;
}

.lh-bar {
  flex: 1;
  min-width: 5rpx;
  border-radius: 4rpx 4rpx 2rpx 2rpx;
  background: linear-gradient(180deg, rgba(56, 242, 200, 0.9), rgba(56, 242, 200, 0.15));
  transform-origin: bottom;
  animation: barIn 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
  opacity: 0.9;
}

@keyframes barIn {
  from { transform: scaleY(0); opacity: 0; }
  to { transform: scaleY(1); opacity: 0.9; }
}

.lh-foot {
  display: flex;
  justify-content: space-between;
  gap: 10rpx;
  margin-top: 10rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  font-size: 18rpx;
  color: var(--text2);
  flex-wrap: wrap;
  word-break: break-all;
}

/* 工具卡（两列） */
.tool-grid {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.tool-card {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(18, 30, 50, 0.88);
  border: 1rpx solid rgba(120, 180, 220, 0.12);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.22);
  transition: transform 150ms ease-out, border-color 150ms ease-out;
}

.tool-card:active {
  transform: scale(0.975);
  border-color: rgba(56, 242, 200, 0.45);
}

.tool-ico {
  width: 64rpx;
  height: 64rpx;
  min-width: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.pet-ico {
  background: linear-gradient(135deg, rgba(56, 242, 200, 0.18), rgba(58, 167, 255, 0.10));
  border: 1rpx solid rgba(56, 242, 200, 0.25);
}

.chain-ico {
  background: linear-gradient(135deg, rgba(58, 167, 255, 0.18), rgba(139, 92, 246, 0.12));
  border: 1rpx solid rgba(58, 167, 255, 0.25);
}

.tool-info {
  flex: 1;
  min-width: 0;
}

.tool-title {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--text);
  white-space: nowrap;
}

.tool-desc {
  margin-top: 2rpx;
  font-size: 19rpx;
  color: var(--text2);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tool-arrow {
  font-size: 26rpx;
  color: var(--text2);
}

/* 金价计算器 */
.gold-card {
  flex-shrink: 0;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(255, 200, 87, 0.10), rgba(18, 30, 50, 0.94) 48%, rgba(56, 242, 200, 0.08));
  border: 1rpx solid rgba(255, 200, 87, 0.28);
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.26);
}

.gold-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.gold-title {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--text);
}

.gold-ratio {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: var(--warn);
  line-height: 1.4;
  word-break: break-all;
}

.gold-setting {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
  font-size: 17rpx;
  color: var(--warn);
  background: rgba(255, 200, 87, 0.08);
  border: 1rpx solid rgba(255, 200, 87, 0.3);
}

.gold-body {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
  margin-top: 10rpx;
}

.gold-field {
  flex: 1;
  min-width: 0;
}

.gold-label {
  display: block;
  font-size: 19rpx;
  color: var(--text2);
  margin-bottom: 5rpx;
}

.gold-input-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 12rpx;
  border-radius: 14rpx;
  background: rgba(0, 0, 0, 0.22);
  border: 1rpx solid rgba(120, 180, 220, 0.16);
}

.gold-input {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  font-weight: 700;
  color: var(--text);
  text-align: right;
}

.gold-unit {
  flex-shrink: 0;
  font-size: 18rpx;
  color: var(--text2);
}

.gold-eq {
  flex-shrink: 0;
  padding-bottom: 16rpx;
  font-size: 22rpx;
  color: var(--accent);
}

.gold-presets {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
}

.gold-chip {
  padding: 3rpx 12rpx;
  border-radius: 12rpx;
  font-size: 18rpx;
  color: var(--text2);
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.gold-chip:active {
  color: var(--accent);
  border-color: rgba(56, 242, 200, 0.4);
}

.gold-hint {
  margin-left: auto;
  font-size: 17rpx;
  color: var(--text2);
}

/* 工具网格 */
.section-label {
  margin: 4rpx 4rpx 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.mini-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  flex-shrink: 0;
}

.mini-tool {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  height: 92rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  transition: transform 140ms ease-out, border-color 140ms ease-out;
}

.mini-tool:active {
  transform: scale(0.95);
  border-color: rgba(56, 242, 200, 0.35);
  background: rgba(56, 242, 200, 0.06);
}

.mt-icon {
  font-size: 28rpx;
}

.mt-label {
  font-size: 18rpx;
  color: var(--text2);
  text-align: center;
  line-height: 1.2;
  white-space: nowrap;
}

.hub-ft {
  padding-top: 10rpx;
  text-align: center;
  font-size: 17rpx;
  color: rgba(139, 163, 191, 0.45);
  line-height: 1.6;
  flex-shrink: 0;
}

/* 金价设置弹窗 */
.gold-setting-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 10rpx 0 16rpx;
}

.gold-setting-input {
  flex: 1;
  min-width: 0;
  padding: 16rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(120, 180, 220, 0.16);
  color: var(--accent);
  font-size: 30rpx;
  font-weight: 700;
  text-align: right;
}

.gold-setting-unit {
  flex-shrink: 0;
  font-size: 21rpx;
  color: var(--text2);
}

.gold-setting-eq {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--warn);
}

.gold-setting-hint {
  font-size: 20rpx;
  color: var(--text2);
  line-height: 1.7;
}

/* 小屏压缩，保证不出现滚动 */
@media (max-height: 720px) {
  .hub-slogan { font-size: 34rpx; }
  .ledger-hero { padding: 16rpx 20rpx; margin-bottom: 10rpx; }
  .lh-value { font-size: 40rpx; }
  .lh-spark { height: 28rpx; }
  .tool-card { padding: 12rpx 14rpx; }
  .gold-card { padding: 14rpx 16rpx; margin-bottom: 8rpx; }
  .gold-hint { display: none; }
  .mini-tool { height: 76rpx; }
  .hub-ft { display: none; }
}

/* PC / 大屏：高分辨率下放大字号与触控区，固定间距，避免字体过小/间隙过大 */
@media (min-width: 768px) {
  .home-page {
    padding-bottom: 88px;
  }

  .home-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 12px 32px 0;
    justify-content: flex-start;
    gap: 18px;
  }

  .hub-brand { font-size: 14px; }
  .hub-slogan { font-size: 36px; margin-top: 2px; }

  .ledger-hero { padding: 22px 26px; border-radius: 22px; }
  .lh-title { font-size: 20px; }
  .lh-badge { font-size: 12px; }
  .lh-arrow { font-size: 13px; }
  .lh-label { font-size: 13px; }
  .lh-value { font-size: 42px; }
  .lh-value-sm { font-size: 20px; }
  .lh-spark { height: 44px; margin-top: 12px; }
  .lh-foot { font-size: 13px; padding-top: 10px; }

  .tool-card { padding: 18px 20px; gap: 14px; border-radius: 18px; }
  .tool-ico { width: 52px; height: 52px; min-width: 52px; font-size: 26px; border-radius: 14px; }
  .tool-title { font-size: 18px; }
  .tool-desc { font-size: 13px; }
  .tool-arrow { font-size: 18px; }

  .gold-card { padding: 20px 24px; border-radius: 20px; }
  .gold-title { font-size: 18px; }
  .gold-ratio { font-size: 13px; }
  .gold-label { font-size: 13px; }
  .gold-input-row { padding: 10px 14px; }
  .gold-input { font-size: 24px; }
  .gold-unit { font-size: 13px; }
  .gold-eq { font-size: 16px; padding-bottom: 18px; }
  .gold-chip { font-size: 13px; padding: 4px 12px; }
  .gold-hint { font-size: 12px; }
  .gold-setting { font-size: 13px; padding: 5px 14px; }

  .section-label { font-size: 15px; margin: 0 4px 10px; }
  .mini-grid { gap: 12px; }
  .mini-tool { height: 86px; border-radius: 14px; gap: 6px; }
  .mt-icon { font-size: 24px; }
  .mt-label { font-size: 13px; }
  .hub-ft { font-size: 12px; padding-top: 8px; }
}

@media (min-width: 1200px) {
  .home-inner {
    max-width: 1080px;
    padding: 16px 56px 0;
    gap: 22px;
  }

  .hub-slogan { font-size: 40px; }
  .lh-value { font-size: 48px; }
  .mini-tool { height: 96px; }
  .mt-label { font-size: 14px; }
}

/* iPad 横屏等「宽但矮」的设备：压缩高度，保证一屏不截断 */
@media (min-width: 768px) and (max-height: 820px) {
  .home-inner {
    padding: 8px 24px 0;
    gap: 10px;
  }

  .hub-brand { font-size: 12px; }
  .hub-slogan { font-size: 28px; }
  .ledger-hero { padding: 14px 18px; border-radius: 18px; }
  .lh-title { font-size: 16px; }
  .lh-value { font-size: 32px; }
  .lh-spark { height: 26px; margin-top: 6px; }
  .lh-foot { font-size: 11px; padding-top: 6px; }

  .tool-card { padding: 10px 14px; gap: 10px; }
  .tool-ico { width: 40px; height: 40px; min-width: 40px; font-size: 20px; }
  .tool-title { font-size: 15px; }
  .tool-desc { font-size: 11px; }

  .gold-card { padding: 12px 16px; }
  .gold-title { font-size: 15px; }
  .gold-ratio { font-size: 11px; }
  .gold-label { font-size: 11px; }
  .gold-input-row { padding: 6px 10px; }
  .gold-input { font-size: 18px; }
  .gold-presets { margin-top: 4px; }
  .gold-chip { font-size: 11px; padding: 2px 8px; }
  .gold-hint { display: none; }

  .section-label { font-size: 13px; margin-bottom: 6px; }
  .mini-grid { gap: 8px; }
  .mini-tool { height: 64px; border-radius: 12px; gap: 3px; }
  .mt-icon { font-size: 18px; }
  .mt-label { font-size: 11px; }
  .hub-ft { display: none; }
}

