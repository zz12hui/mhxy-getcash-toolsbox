page { padding-bottom: 140rpx; }

.home-scroll {
  height: 100%;
}

.hub-view {
  flex: 1;
  min-height: 100%;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  position: relative;
  padding-top: 24rpx;
  overflow: hidden;
}

.hub-bg {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
  z-index: 0;
  background: linear-gradient(180deg, #060a12 0%, #0a1322 55%, #0b1524 100%);
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(180rpx);
  opacity: 0.5;
}

.orb1 {
  width: 620rpx;
  height: 620rpx;
  background: radial-gradient(circle, rgba(56, 242, 200, 0.16), transparent 68%);
  top: -220rpx;
  right: -160rpx;
}

.orb2 {
  width: 520rpx;
  height: 520rpx;
  background: radial-gradient(circle, rgba(58, 167, 255, 0.14), transparent 68%);
  bottom: 120rpx;
  left: -180rpx;
}

.orb3 {
  width: 440rpx;
  height: 440rpx;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.12), transparent 70%);
  top: 44%;
  left: 46%;
}

.grid-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-image:
    linear-gradient(rgba(120, 180, 220, 0.035) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(120, 180, 220, 0.035) 1rpx, transparent 1rpx);
  background-size: 56rpx 56rpx;
}

.hub-main {
  position: relative;
  z-index: 1;
  padding: 32rpx 28rpx 60rpx;
  max-width: 700rpx;
  width: 100%;
  box-sizing: border-box;
}

.hub-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.hub-brand {
  font-size: 24rpx;
  color: var(--text2);
  letter-spacing: 1rpx;
}

.hub-slogan {
  margin-top: 8rpx;
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text);
  line-height: 1.2;
}

.accent-text {
  color: var(--accent);
  text-shadow: 0 0 24rpx rgba(56, 242, 200, 0.35);
}

.hub-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--accent);
  background: linear-gradient(135deg, rgba(56, 242, 200, 0.18), rgba(58, 167, 255, 0.10));
  border: 1rpx solid rgba(56, 242, 200, 0.45);
  box-shadow: 0 0 26rpx rgba(56, 242, 200, 0.18);
}

/* 收益账本大栏目 */
.ledger-hero {
  margin: 0 0 26rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(56, 242, 200, 0.13), rgba(13, 24, 40, 0.95) 55%, rgba(58, 167, 255, 0.10));
  border: 1rpx solid rgba(56, 242, 200, 0.32);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.38), inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
  position: relative;
  overflow: hidden;
}

.ledger-hero:active {
  transform: scale(0.985);
  transition: transform 150ms ease-out;
}

.lh-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.lh-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.lh-icon { font-size: 32rpx; }

.lh-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.lh-badge {
  font-size: 18rpx;
  color: var(--accent);
  border: 1rpx solid rgba(56, 242, 200, 0.35);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
  background: rgba(56, 242, 200, 0.06);
}

.lh-arrow {
  font-size: 22rpx;
  color: var(--text2);
}

.lh-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 18rpx;
  margin-top: 22rpx;
}

.lh-label {
  display: block;
  font-size: 20rpx;
  color: var(--text2);
}

.lh-value {
  display: block;
  font-size: 58rpx;
  font-weight: 800;
  line-height: 1.15;
  margin-top: 6rpx;
  word-break: break-all;
  text-shadow: 0 0 32rpx rgba(56, 242, 200, 0.22);
}

.lh-value-sm {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin-top: 6rpx;
}

.lh-spark {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  height: 64rpx;
  margin-top: 20rpx;
}

.lh-bar {
  flex: 1;
  min-width: 6rpx;
  border-radius: 6rpx 6rpx 2rpx 2rpx;
  background: linear-gradient(180deg, rgba(56, 242, 200, 0.9), rgba(56, 242, 200, 0.15));
  transform-origin: bottom;
  animation: barIn 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
  opacity: 0.9;
}

@keyframes barIn {
  from { transform: scaleY(0); opacity: 0; }
  to { transform: scaleY(1); opacity: 0.9; }
}

.lh-foot {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  font-size: 19rpx;
  color: var(--text2);
  flex-wrap: wrap;
}

.section-label {
  margin: 30rpx 4rpx 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 1rpx;
}

/* 工具卡 */
.tool-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tool-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 26rpx;
  background: rgba(18, 30, 50, 0.88);
  border: 1rpx solid rgba(120, 180, 220, 0.12);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.25);
  transition: transform 150ms ease-out, border-color 150ms ease-out;
}

.tool-card:active {
  transform: scale(0.985);
  border-color: rgba(56, 242, 200, 0.45);
}

.tool-ico {
  width: 92rpx;
  height: 92rpx;
  min-width: 92rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.pet-ico {
  background: linear-gradient(135deg, rgba(56, 242, 200, 0.18), rgba(58, 167, 255, 0.10));
  border: 1rpx solid rgba(56, 242, 200, 0.25);
}

.chain-ico {
  background: linear-gradient(135deg, rgba(58, 167, 255, 0.18), rgba(139, 92, 246, 0.12));
  border: 1rpx solid rgba(58, 167, 255, 0.25);
}

.tool-info {
  flex: 1;
  min-width: 0;
}

.tool-title {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--text);
}

.tool-desc {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--text2);
  line-height: 1.5;
}

.tool-tags {
  display: flex;
  gap: 8rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.tool-tag {
  font-size: 18rpx;
  color: var(--text2);
  padding: 3rpx 12rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.tool-arrow {
  font-size: 34rpx;
  color: var(--text2);
  padding-right: 4rpx;
}

/* 快捷工具 */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.quick-module {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.035);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.quick-module:active {
  background: rgba(56, 242, 200, 0.08);
  border-color: rgba(56, 242, 200, 0.3);
}

.qm-icon {
  font-size: 34rpx;
  margin-bottom: 6rpx;
}

.qm-label {
  font-size: 19rpx;
  color: var(--text2);
}

.hub-ft {
  margin-top: 40rpx;
  text-align: center;
  font-size: 19rpx;
  color: rgba(139, 163, 191, 0.35);
  line-height: 1.8;
}

/* 金价计算器 */
.gold-card {
  margin-top: 18rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background:
    linear-gradient(135deg, rgba(255, 200, 87, 0.10), rgba(18, 30, 50, 0.94) 48%, rgba(56, 242, 200, 0.08));
  border: 1rpx solid rgba(255, 200, 87, 0.28);
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.3);
}

.gold-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.gold-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

.gold-ratio {
  margin-top: 6rpx;
  font-size: 19rpx;
  color: var(--warn);
  line-height: 1.5;
}

.gold-setting {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
  font-size: 19rpx;
  color: var(--warn);
  background: rgba(255, 200, 87, 0.08);
  border: 1rpx solid rgba(255, 200, 87, 0.3);
}

.gold-body {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  margin-top: 22rpx;
}

.gold-field {
  flex: 1;
  min-width: 0;
}

.gold-label {
  display: block;
  font-size: 19rpx;
  color: var(--text2);
  margin-bottom: 8rpx;
}

.gold-input-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.22);
  border: 1rpx solid rgba(120, 180, 220, 0.16);
}

.gold-input {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  text-align: right;
}

.gold-unit {
  flex-shrink: 0;
  font-size: 19rpx;
  color: var(--text2);
}

.gold-eq {
  flex-shrink: 0;
  padding-bottom: 22rpx;
  font-size: 26rpx;
  color: var(--accent);
}

.gold-presets {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.gold-chip {
  padding: 6rpx 16rpx;
  border-radius: 14rpx;
  font-size: 19rpx;
  color: var(--text2);
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.gold-chip:active {
  color: var(--accent);
  border-color: rgba(56, 242, 200, 0.4);
}

.gold-hint {
  margin-left: auto;
  font-size: 18rpx;
  color: var(--text2);
}

/* 金价设置弹窗 */
.gold-setting-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 10rpx 0 16rpx;
}

.gold-setting-input {
  flex: 1;
  min-width: 0;
  padding: 16rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(120, 180, 220, 0.16);
  color: var(--accent);
  font-size: 30rpx;
  font-weight: 700;
  text-align: right;
}

.gold-setting-unit {
  flex-shrink: 0;
  font-size: 21rpx;
  color: var(--text2);
}

.gold-setting-eq {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--warn);
}

.gold-setting-hint {
  font-size: 20rpx;
  color: var(--text2);
  line-height: 1.7;
}

/* PC / 大屏 */
@media (min-width: 768px) {
  .tool-grid {
    flex-direction: row;
  }

  .tool-grid .tool-card {
    flex: 1;
    margin-bottom: 0;
  }

  .quick-grid {
    gap: 16rpx;
  }

  .quick-module {
    height: 128rpx;
  }

  .hub-main {
    padding-top: 48rpx;
  }
}
