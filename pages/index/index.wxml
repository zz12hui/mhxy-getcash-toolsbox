<view class="home-page" style="padding-top: {{statusBarHeight + 6}}px;">
  <view class="hub-bg">
    <view class="orb orb1"></view>
    <view class="orb orb2"></view>
    <view class="orb orb3"></view>
    <view class="grid-mask"></view>
  </view>

  <view class="home-inner">
    <view class="hub-top anim-up" style="padding-right: {{navRight}}px;">
      <view>
        <view class="hub-brand">梦幻搞钱工具箱</view>
        <view class="hub-slogan">今天也在<text class="accent-text">搞钱</text></view>
      </view>
      <view class="hub-avatar" bindtap="goProfile">我</view>
    </view>

    <view class="ledger-hero anim-up" style="animation-delay: 50ms;" bindtap="goLedger">
      <view class="lh-head">
        <view class="lh-title-wrap">
          <text class="lh-icon">📊</text>
          <text class="lh-title">收益账本</text>
          <text class="lh-badge">ROI · 时薪 · 月化</text>
        </view>
        <text class="lh-arrow">查看 ›</text>
      </view>
      <view class="lh-main">
        <view>
          <text class="lh-label">累计净收益</text>
          <text class="lh-value" style="color:{{ledgerSummary.profitPos ? 'var(--accent)' : 'var(--danger)'}};">{{ledgerSummary.profitStr}}</text>
        </view>
        <view class="lh-roi">
          <text class="lh-label">投入产出比</text>
          <text class="lh-value-sm">{{ledgerSummary.roiStr}}</text>
        </view>
      </view>
      <view wx:if="{{sparkBars.length}}" class="lh-spark">
        <view wx:for="{{sparkBars}}" wx:key="index" class="lh-bar" style="height:{{item}}%; animation-delay:{{index * 28}}ms;"></view>
      </view>
      <view class="lh-foot">
        <text>{{ledgerSummary.costStr}} 投入 · {{ledgerSummary.incomeStr}} 产出 · {{ledgerSummary.count}} 轮</text>
        <text>时薪 {{ledgerSummary.hourlyStr}}</text>
      </view>
    </view>

    <view class="tool-grid anim-up" style="animation-delay: 90ms;">
      <view class="tool-card" bindtap="goPet">
        <view class="tool-ico pet-ico">🐾</view>
        <view class="tool-info">
          <view class="tool-title">宠环助手</view>
          <view class="tool-desc">100 环 · 积分 · 预测</view>
        </view>
        <text class="tool-arrow">›</text>
      </view>
      <view class="tool-card" bindtap="goChain">
        <view class="tool-ico chain-ico">📜</view>
        <view class="tool-info">
          <view class="tool-title">跑环助手</view>
          <view class="tool-desc">300 环 · 三段奖励</view>
        </view>
        <text class="tool-arrow">›</text>
      </view>
    </view>

    <view class="gold-card anim-up" style="animation-delay: 130ms;">
      <view class="gold-head">
        <view>
          <view class="gold-title">💱 金价计算器</view>
          <view class="gold-ratio">{{goldRatioText}}</view>
        </view>
        <view class="gold-setting" bindtap="openGoldSettings">比例</view>
      </view>
      <view class="gold-body">
        <view class="gold-field">
          <text class="gold-label">梦幻币</text>
          <view class="gold-input-row">
            <input class="gold-input" type="digit" value="{{goldWan}}" bindinput="onGoldWanInput" placeholder="0"/>
            <text class="gold-unit">万两</text>
          </view>
        </view>
        <view class="gold-eq">⇄</view>
        <view class="gold-field">
          <text class="gold-label">人民币</text>
          <view class="gold-input-row">
            <input class="gold-input" type="digit" value="{{goldYuan}}" bindinput="onGoldYuanInput" placeholder="0"/>
            <text class="gold-unit">元</text>
          </view>
        </view>
      </view>
      <view class="gold-presets">
        <view class="gold-chip" bindtap="quickGold" data-wan="1000">1000万</view>
        <view class="gold-chip" bindtap="quickGold" data-wan="3000">3000万</view>
        <view class="gold-chip" bindtap="quickGold" data-wan="10000">1亿</view>
        <text class="gold-hint">改任意一边自动换算</text>
      </view>
    </view>

    <view class="section-label anim-up" style="animation-delay: 160ms;">全部工具</view>
    <view class="mini-grid anim-up" style="animation-delay: 180ms;">
      <view class="mini-tool" bindtap="goFaq">
        <text class="mt-icon">📖</text>
        <text class="mt-label">知识库</text>
      </view>
      <view class="mini-tool" bindtap="goPriceRef">
        <text class="mt-icon">📋</text>
        <text class="mt-label">物品参考价</text>
      </view>
      <view class="mini-tool" bindtap="goPetTool" data-tool="predict">
        <text class="mt-icon">🔮</text>
        <text class="mt-label">宠环预测</text>
      </view>
      <view class="mini-tool" bindtap="goPetTool" data-tool="control">
        <text class="mt-icon">🎯</text>
        <text class="mt-label">控分计算</text>
      </view>
      <view class="mini-tool" bindtap="goPetTool" data-tool="batch">
        <text class="mt-icon">📦</text>
        <text class="mt-label">批量填充</text>
      </view>
      <view class="mini-tool" bindtap="goChainTool" data-tool="history">
        <text class="mt-icon">📜</text>
        <text class="mt-label">跑环历史</text>
      </view>
      <view class="mini-tool" bindtap="goChainTool" data-tool="stats">
        <text class="mt-icon">📈</text>
        <text class="mt-label">跑环统计</text>
      </view>
      <view class="mini-tool" bindtap="goChainTool" data-tool="reward">
        <text class="mt-icon">🏆</text>
        <text class="mt-label">奖励记录</text>
      </view>
    </view>

    <view class="hub-ft">
      <text>梦幻搞钱工具箱 · 本地存储 · </text>
      <text>{{clockStr}}</text>
    </view>
  </view>
</view>

<!-- 金价比例设置 -->
<view class="sheet-overlay" catchtouchmove="noop" wx:if="{{showGoldSettings}}" bindtap="closeGoldSettings">
  <view class="sheet" catchtap="noop">
    <view class="sheet-handle"></view>
    <view class="sheet-title">💱 金价比例设置</view>
    <view class="gold-setting-row">
      <input type="digit" class="gold-setting-input" value="{{goldRatioWan}}" data-k="goldRatioWan" bindinput="onGoldRatioInput"/>
      <text class="gold-setting-unit">万两</text>
      <text class="gold-setting-eq">=</text>
      <input type="digit" class="gold-setting-input" value="{{goldRatioYuan}}" data-k="goldRatioYuan" bindinput="onGoldRatioInput"/>
      <text class="gold-setting-unit">元</text>
    </view>
    <view class="gold-setting-hint">默认 3000 万两 = 202 元；修改后所有换算（含账本币种）立即生效。</view>
    <view class="sheet-actions">
      <view class="btn" bindtap="resetGoldSettings">恢复默认</view>
      <view class="btn btn-grad" style="flex:1" bindtap="saveGoldSettings">保存</view>
    </view>
  </view>
</view>
