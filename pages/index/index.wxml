<scroll-view scroll-y class="home-scroll {{reduceMotion ? 'reduce-motion' : ''}}">
  <view class="hub-view" style="padding-top: {{statusBarHeight + 8}}px;">
    <view class="hub-bg">
      <view class="orb orb1"></view>
      <view class="orb orb2"></view>
      <view class="orb orb3"></view>
      <view class="grid-mask"></view>
    </view>

    <view class="hub-main">
      <view class="hub-top anim-up" style="padding-right: {{navRight}}px;">
        <view>
          <view class="hub-brand">梦幻搞钱工具箱</view>
          <view class="hub-slogan">今天也在<text class="accent-text">搞钱</text></view>
        </view>
        <view class="hub-avatar" bindtap="goProfile">我</view>
      </view>

      <view class="ledger-hero anim-up" style="animation-delay: 60ms;" bindtap="goLedger">
        <view class="lh-head">
          <view class="lh-title-wrap">
            <text class="lh-icon">📊</text>
            <text class="lh-title">收益账本</text>
            <text class="lh-badge">ROI · 时薪 · 月化</text>
          </view>
          <text class="lh-arrow">查看 ›</text>
        </view>
        <view class="lh-main">
          <view>
            <text class="lh-label">累计净收益</text>
            <text class="lh-value" style="color:{{ledgerSummary.profitPos ? 'var(--accent)' : 'var(--danger)'}};">{{ledgerSummary.profitStr}}</text>
          </view>
          <view class="lh-roi">
            <text class="lh-label">投入产出比</text>
            <text class="lh-value-sm">{{ledgerSummary.roiStr}}</text>
          </view>
        </view>
        <view wx:if="{{sparkBars.length}}" class="lh-spark">
          <view wx:for="{{sparkBars}}" wx:key="index" class="lh-bar" style="height:{{item}}%; animation-delay:{{index * 28}}ms;"></view>
        </view>
        <view class="lh-foot">
          <text>{{ledgerSummary.costStr}} 投入 · {{ledgerSummary.incomeStr}} 产出 · {{ledgerSummary.count}} 轮</text>
          <text>时薪 {{ledgerSummary.hourlyStr}}</text>
        </view>
      </view>

      <view class="section-label anim-up" style="animation-delay: 120ms;">核心工具</view>

      <view class="tool-grid">
        <view class="tool-card anim-up" style="animation-delay: 160ms;" bindtap="goPet">
          <view class="tool-ico pet-ico">🐾</view>
          <view class="tool-info">
            <view class="tool-title">宠环助手</view>
            <view class="tool-desc">100 环 · 积分追踪 · 奖励预测</view>
            <view class="tool-tags"><text class="tool-tag">100环</text><text class="tool-tag">积分制</text></view>
          </view>
          <text class="tool-arrow">›</text>
        </view>

        <view class="tool-card anim-up" style="animation-delay: 210ms;" bindtap="goChain">
          <view class="tool-ico chain-ico">📜</view>
          <view class="tool-info">
            <view class="tool-title">跑环助手</view>
            <view class="tool-desc">300 环 · 三段奖励 · 书铁区间</view>
            <view class="tool-tags"><text class="tool-tag">300环</text><text class="tool-tag">三段奖励</text></view>
          </view>
          <text class="tool-arrow">›</text>
        </view>
      </view>

      <view class="section-label anim-up" style="animation-delay: 260ms;">快捷工具</view>
      <view class="quick-grid anim-up" style="animation-delay: 300ms;">
        <view class="quick-module" bindtap="goFaq">
          <text class="qm-icon">📖</text>
          <text class="qm-label">知识库</text>
        </view>
        <view class="quick-module" bindtap="onComing">
          <text class="qm-icon">💎</text>
          <text class="qm-label">物价参考</text>
        </view>
        <view class="quick-module" bindtap="onComing">
          <text class="qm-icon">📝</text>
          <text class="qm-label">答题器</text>
        </view>
        <view class="quick-module" bindtap="onComing">
          <text class="qm-icon">⏱️</text>
          <text class="qm-label">传说计时</text>
        </view>
      </view>

      <view class="hub-ft">
        <text>梦幻搞钱工具箱 · 本地存储 · </text>
        <text>{{clockStr}}</text>
      </view>
    </view>
  </view>
</scroll-view>
