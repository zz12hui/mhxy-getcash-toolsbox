<view class="app">
  <scroll-view scroll-y class="scroll-wrap">

    <!-- Account -->
    <view class="profile-section">
      <view class="profile-card" bindtap="onAccountTap">
        <view class="profile-card-left">
          <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" class="profile-avatar" mode="aspectFill"/>
          <view wx:else class="profile-avatar profile-avatar-d">👤</view>
          <view class="profile-name-wrap">
            <text class="profile-name">{{isLoggedIn ? nickName : '未登录'}}</text>
            <text class="profile-sub">{{isLoggedIn ? '点击管理账号（资料/退出）' : '点击登录同步数据到云端'}}</text>
          </view>
        </view>
        <text class="profile-arrow">›</text>
      </view>
    </view>

    <!-- 收益账本入口（大栏目） -->
    <view class="profile-section">
      <view class="ledger-hero" bindtap="goLedger">
        <view class="lh-head">
          <view class="lh-title-wrap">
            <text class="lh-icon">📊</text>
            <text class="lh-title">收益账本</text>
            <text class="lh-badge">ROI · 时薪 · 月化</text>
          </view>
          <text class="lh-arrow">查看 ›</text>
        </view>
        <view class="lh-main">
          <view>
            <text class="lh-label">累计净收益</text>
            <text class="lh-value" style="color:{{ledgerSummary.profitPos ? 'var(--accent)' : 'var(--danger)'}};">{{ledgerSummary.profitStr}}</text>
          </view>
          <view style="text-align:right;">
            <text class="lh-label">投入产出比</text>
            <text class="lh-value-sm">{{ledgerSummary.roiStr}}</text>
          </view>
        </view>
        <view class="lh-foot">
          <text>{{ledgerSummary.costStr}} 投入 · {{ledgerSummary.count}} 轮已记账</text>
          <text>时薪 {{ledgerSummary.hourlyStr}}</text>
        </view>
      </view>
    </view>

    <!-- Sync -->
    <view class="profile-section" wx:if="{{isLoggedIn}}">
      <view class="section-title">数据同步</view>
      <view class="menu-list">
        <view class="menu-item" bindtap="backupToCloud">
          <text>☁️ 备份到云端</text>
          <text class="menu-item-hint" wx:if="{{!isSyncing}}">{{roleCount}} 个角色 · {{lastSyncAtStr}}</text>
          <text class="menu-item-hint" wx:else>同步中...</text>
        </view>
        <view class="menu-item" bindtap="restoreFromCloud">
          <text>📥 从云端恢复</text>
          <text class="menu-item-hint">›</text>
        </view>
      </view>
    </view>

    <!-- Role switch -->
    <view class="profile-section">
      <view class="section-title">角色管理</view>
      <view class="menu-list">
        <picker mode="selector" value="{{activeUserIndex}}" range="{{userPickerRange}}" bindchange="onUserPickerChange">
          <view class="menu-item">
            <text>🔄 切换角色</text>
            <text class="menu-item-hint">{{activeUserName}} ›</text>
          </view>
        </picker>
      </view>
    </view>

    <!-- 显示与动效 -->
    <view class="profile-section">
      <view class="section-title">显示与动效</view>
      <view class="menu-list">
        <view class="menu-item">
          <text>✨ 精简动效（低端机/省电）</text>
          <switch checked="{{reduceMotion}}" bindchange="toggleReduceMotion" color="#38f2c8"/>
        </view>
      </view>
    </view>

    <!-- Services — 4 per row -->
    <view class="profile-section">
      <view class="section-title">服务</view>
      <view class="service-grid">
        <view class="service-item" bindtap="goFeedback">
          <text class="service-icon">💬</text>
          <text class="service-label">意见反馈</text>
        </view>
        <view class="service-item" bindtap="goManual">
          <text class="service-icon">📋</text>
          <text class="service-label">操作手册</text>
        </view>
        <view class="service-item" bindtap="goPrivacy">
          <text class="service-icon">🔒</text>
          <text class="service-label">隐私与协议</text>
        </view>
        <view class="service-item" bindtap="openReward">
          <text class="service-icon">🙏</text>
          <text class="service-label">赞赏作者</text>
        </view>
      </view>
    </view>

    <view style="height:80rpx;"></view>
  </scroll-view>

  <!-- 赞赏作者 -->
  <view class="sheet-overlay" catchtouchmove="noop" wx:if="{{showReward}}" bindtap="closeReward">
    <view class="sheet reward-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-title">🙏 赞赏作者</view>
      <view class="reward-tip">如果这个小工具帮你省了算账时间，可以请作者喝杯奶茶。自愿赞赏，不影响任何功能，也请未成年人不要赞赏。</view>
      <image class="reward-qr" src="/images/reward-qr.jpg" mode="widthFix" show-menu-by-longpress bindtap="previewReward"></image>
      <view class="reward-name">微信扫码 · ZZ12HUI</view>
      <view class="sheet-actions">
        <view class="btn" bindtap="closeReward">关闭</view>
        <view class="btn btn-grad" style="flex:1" bindtap="previewReward">查看大图</view>
      </view>
    </view>
  </view>
</view>
