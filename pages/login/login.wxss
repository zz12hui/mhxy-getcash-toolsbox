.login-scroll {
  flex: 1;
}

.login-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx 40rpx;
}

.login-avatar-wrap {
  margin-bottom: 32rpx;
}

.login-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
}

.login-avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  border: 2rpx solid var(--border);
  font-size: 60rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 12rpx;
}

.login-desc {
  font-size: 26rpx;
  color: var(--text2);
  margin-bottom: 48rpx;
}

.login-err {
  font-size: 24rpx;
  color: #ff4d4f;
  margin-bottom: 16rpx;
  text-align: center;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.login-skip {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--text2);
  padding: 16rpx 32rpx;
}

/* Avatar button */
.avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: none;
  border: none;
  padding: 0;
  margin-bottom: 24rpx;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

.avatar-hint {
  font-size: 22rpx;
  color: var(--accent);
}

/* Profile info */
.profile-info {
  width: 100%;
  background: var(--surface);
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 40rpx;
  border: 1rpx solid var(--border);
}

.profile-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  border-bottom: 1rpx solid var(--border);
}

.profile-info-row:last-child {
  border-bottom: none;
}

.pi-label {
  font-size: 28rpx;
  color: var(--text);
  width: 100rpx;
}

.pi-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
  text-align: right;
}

.pi-value {
  font-size: 28rpx;
  color: var(--text2);
}

/* Logout bar — fixed bottom center */
.logout-bar {
  display: flex;
  justify-content: center;
  padding: 24rpx 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--border);
  background: var(--bg);
}
