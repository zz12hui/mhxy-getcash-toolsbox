.manual-tabs {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--border);
}

.manual-tab {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 36rpx;
  background: var(--surface);
  color: var(--text2);
  font-size: 28rpx;
  border: 1rpx solid var(--border);
}

.manual-tab.active {
  background: var(--accent);
  color: #0f1623;
  border-color: var(--accent);
  font-weight: 600;
}

.manual-scroll {
  flex: 1;
  height: 100%;
  padding: 16rpx 24rpx;
}

.manual-step {
  background: var(--surface);
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid var(--border);
  overflow: hidden;
}

.manual-step.expanded {
  border-color: var(--accent);
}

.step-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 20rpx;
}

.step-num {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--surface2);
  color: var(--text2);
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.expanded .step-num {
  background: var(--accent);
  color: #0f1623;
}

.step-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.step-title-wrap {
  flex: 1;
}

.step-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.step-arrow {
  font-size: 20rpx;
  color: var(--text2);
  flex-shrink: 0;
}

.step-desc {
  padding: 0 20rpx 24rpx 80rpx;
  font-size: 26rpx;
  color: var(--text2);
  line-height: 1.7;
}
